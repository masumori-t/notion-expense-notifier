# このファイルを .env にコピーして値を設定してください(.env はコミットしないこと)
# cp .env.example .env

# --- 必須 ---
# Notion Integrations (https://www.notion.so/my-integrations) で作成した
# internal connection の Integration Token
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 小口精算フォーム回答テーブルのデータベースID(URL中の32桁の文字列)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# タスクを作成する先のタスクDBの「データソースID」
# (対象データベースを開き、Notionの「fetch」等で <data-source url="collection://xxxx"> の xxxx 部分)
NOTION_TASK_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- 推奨(未設定でもタスクは作成されるが、担当者が空欄になる) ---
# タスクの「対応者」に設定するNotionユーザーID
# (Notionの「fetch id="self"」や、ワークスペースのメンバー一覧などから取得)
NOTION_ASSIGNEE_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- 任意(小口精算フォームDB側のプロパティ名がデフォルトと異なる場合のみ上書き) ---
# PROP_PAYEE=回答者
# PROP_AMOUNT=金額（税込総額）
# PROP_SUMMARY=摘要
# PROP_DATE=日付
# PROP_CATEGORY=科目
# PROP_SETTLED=清算完了

# --- 任意(「清算完了」列の実際のプロパティ型に応じて指定) ---
# checkbox(チェックボックス) / status(ステータス) / select(セレクト) のいずれか。デフォルトは checkbox
# SETTLED_PROPERTY_TYPE=checkbox
# SETTLED_PROPERTY_TYPE が status または select の場合、「完了」を表す値の名前
# SETTLED_VALUE=完了

# --- 任意(タスクDB側のプロパティ名・作成するタスクの内容を変更したい場合) ---
# TASK_TITLE_PROPERTY=内容
# TASK_TITLE=小口清算をする
# TASK_ASSIGNEE_PROPERTY=対応者
# TASK_STATUS_PROPERTY=ステータス
# TASK_STATUS_VALUE=❗️Todo
# TASK_DUE_DATE_PROPERTY=予定日
# TASK_ICON=💴

# --- 任意 ---
# 「前回チェック時刻」を保存する状態ファイルのパス
# (GitHub Actions実行間で状態を持たせるため、ワークフローがこのファイルをリポジトリにコミットする)
# STATE_FILE_PATH=state/last-checked.json
